# Rust — each workspace has its own `target/` next to its
# Cargo.toml; the root has none.
/target/
/crate/odyssey/target/
/example/backend/target/

# Cargo local cache
/.cargo-cache/

# pnpm — frontend workspace
/pnpm-lock.yaml
/node_modules/
/example/frontend/node_modules/
/.example/frontend/node_modules/

# OS / editor
.DS_Store
*.swp
*.swo
.vscode/
.idea/

# Build artifacts
*.o
*.so
*.dylib
*.dll
*.wasm

# Per-phase worker / audit reports left in the workspace
# root during the long phase-8 migration. Not part of the
# codebase.
.phase*.md

# React frontend (built on demand via
# `pnpm --dir example/frontend build`)
/example/frontend/dist/
