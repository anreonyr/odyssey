# Rust — cargo workspaces drop `target/` at the workspace
# root. `crate/` is the lib workspace, `example/back/` is
# a single crate (no workspace) so its target sits there.
/crate/target/
/example/back/target/

# Cargo local cache
/.cargo-cache/

# pnpm — single frontend package at example/fore/.
# The root /node_modules/ + /pnpm-lock.yaml + /.pnpm-store/
# were removed when the layout stopped being a pnpm
# workspace at the project root.
/node_modules/
/example/fore/node_modules/
/.pnpm-store/

# OS / editor
.DS_Store
*.swp
*.swo
.vscode/
.idea/

# Build artifacts
*.o
*.so
*.dylib
*.dll
*.wasm

# Per-phase worker / audit reports left in the workspace
# root during the long phase-8 migration. Not part of the
# codebase.
.phase*.md

# React frontend (built on demand via
# `./scripts/fore.sh build`)
/example/fore/dist/
