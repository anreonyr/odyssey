{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "react-perf",
    "import",
    "vitest",
    "node",
    "jsx-a11y"
  ],
  "env": {
    "browser": true,
    "es2022": true
  },
  "ignorePatterns": ["dist", "node_modules", "pnpm-lock.yaml"],
  "rules": {
    "react/set-state-in-effect": "warn",
    "jsx-a11y/label-has-associated-control": "warn"
  }
}
